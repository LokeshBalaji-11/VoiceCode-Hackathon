# === CORE FALLBACK LLM: xAI GROK API ===
FALLBACK_LLM_BASE_URL=https://api.x.ai/v1
FALLBACK_LLM_API_KEY=xai-replace-me
FALLBACK_LLM_MODEL=grok-3-mini-fast

# GitHub configuration for Branch + Pull Request creation
GITHUB_TOKEN=ghp_replace_me
GITHUB_REPO=your-github-username/voicecode-demo-target
GITHUB_BASE_BRANCH=main

# If true, runs git branches locally without pushing to GitHub API
DRY_RUN_MODE=true

# === SPONSOR 1: ASSEMBLYAI (STAGE 4) ===
ASSEMBLYAI_API_KEY=replace_with_assemblyai_key

# === SPONSOR 2: SGLANG (STAGE 5) ===
SGLANG_BASE_URL=
SGLANG_API_KEY=EMPTY
SGLANG_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct

# === SPONSOR 3: N8N (STAGE 6) ===
N8N_WEBHOOK_URL=

# === SPONSOR 4: LEXSI LABS (STAGE 7) ===
ENABLE_LEXSI_ADAPTER=false